# ============================================================================
# Web 用户端站点配置【模板】
#
# 本文件会被打进镜像，放在 /etc/nginx/templates/default.conf.template。
# nginx 官方镜像的启动脚本（docker-entrypoint.d/20-envsubst-on-templates.sh）
# 会在【容器启动时】用 envsubst 把下列 ${...} 占位符替换成运行期环境变量，
# 再把结果写到 /etc/nginx/conf.d/default.conf（覆盖镜像自带的 default.conf）。
#
# 因此同一个镜像可以指向不同的后端 / 不同的挂载路径，改配置只需重启容器。
#
# 可用的运行期环境变量（默认值由 Dockerfile 的 ENV 提供，可在 docker run 时用 -e 覆盖）：
#   BACKEND_HOST  后端服务主机名，默认 sky-backend（容器间用 compose 服务名互访）
#   BACKEND_PORT  后端服务端口，  默认 8080
#   APP_BASE      前端挂载路径，  默认 /（随构建期 VITE_APP_BASE 走）
#
# ⚠ APP_BASE 与构建期的 VITE_APP_BASE 必须一致：
#   产物里的资源引用路径由【构建期】的 VITE_APP_BASE 决定（如 /web/assets/xxx.js），
#   本模板负责在【运行期】把这些路径提供出来。Dockerfile 已把构建期的 VITE_APP_BASE
#   默认落到运行期的 APP_BASE，所以正常构建下两者自动一致；
#   只有手动指定 --build-arg VITE_APP_BASE 却忘了同步 APP_BASE 时才会写岔。
#   取值必须「以 / 开头、以 / 结尾」：/ 或 /web/ 。
# ============================================================================

server {
    listen       80;
    server_name  _;                 # 用 IP / 域名访问均可，不绑定特定域名

    charset      utf-8;

    # 留一点请求体上限余量（地址、订单等 JSON 很小，这里只是防手滑）。
    client_max_body_size 10m;

    # 静态文件的根 = 前端构建产物（Dockerfile 里 COPY 进来的 dist/）。
    root  /usr/share/nginx/html;
    index index.html;

    # ---------- 1) 带内容哈希的静态资源：长缓存 ----------
    # 产物里 assets/ 下的文件名含内容哈希，内容变则文件名变，可安全长缓存。
    # 前缀剥掉后再到 root 下找文件：APP_BASE=/web/ 时 /web/assets/x.js -> /assets/x.js。
    location ~* "^${APP_BASE}assets/" {
        rewrite ^${APP_BASE}(.*)$ /$1 break;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ---------- 2) 应用入口与其余静态文件 ----------
    # APP_BASE=/ 时本块即 location / ；APP_BASE=/web/ 时即 location /web/ 。
    location ${APP_BASE} {
        # 剥掉挂载前缀后再到 root 下找文件；APP_BASE=/ 时该 rewrite 为恒等操作。
        rewrite ^${APP_BASE}(.*)$ /$1 break;
        # SPA 回退：正常 hash 路由不会触发，但旧书签 / 手输路径可回退到首页，更稳妥。
        try_files $uri $uri/ /index.html;
        # 入口 HTML 不缓存：避免发新版后浏览器仍拿旧入口、引用到已删除的旧资源。
        add_header Cache-Control "no-cache";
    }

    # 说明：未对「裸挂载前缀」（如 /web，无结尾斜杠）做 301 补斜杠 ——
    # 因为 APP_BASE=/ 时精确匹配 / 再重定向到 / 会自环。子路径部署时请带结尾斜杠访问
    # （/web/），浏览器与链接通常会带。

    # ---------- 3) 接口：/user/**  ->  后端 /user/**（透传，不做路径重写） ----------
    # 末尾的 proxy_pass 只写「主机:端口」、不带 URI，表示原始 URI 原样透传：
    #   /user/shopping-carts  ->  http://<BACKEND_HOST>:<BACKEND_PORT>/user/shopping-carts
    # 这与开发期 vite.config.js 里的 /user 代理（同样不 rewrite）语义一致，
    # 所以前端源码无需任何改动。后端所有用户端端点都在 /user/** 下。
    location /user/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
        proxy_connect_timeout 10s;
    }

    # 容错：访问裸 /user（没有结尾斜杠）时补一个斜杠，避免被 location ${APP_BASE} 兜成首页 HTML。
    location = /user { return 301 /user/; }

    # 可选优化（需要时再打开）：
    # gzip on;
    # gzip_min_length 1k;
    # gzip_comp_level 5;
    # gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
